# Python 虚拟环境与编译缓存
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]

# 本地 IDE 设置
.idea/

# 浏览器登录资料、账号记录及运行日志（包含目录内的运行锁）
/.state/
/data/
logs/
*.log

# 私有配置与环境变量；示例文件可以提交
config.local.toml
.env
.env.*
!.env.example
!.env.template

# 测试、检查工具及构建产物
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/

# 操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini
