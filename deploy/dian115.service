# Edit User, WorkingDirectory and ExecStart to match your Linux installation.
[Unit]
Description=Dian115 daily check-in API and scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dian115
WorkingDirectory=/opt/dian115auto
ExecStart=/opt/dian115auto/.venv/bin/python /opt/dian115auto/checkin.py serve --config /opt/dian115auto/config.toml
Environment=PYTHONUNBUFFERED=1
# Optional file containing DIAN115_API_KEY=...
EnvironmentFile=-/etc/dian115.env
Restart=on-failure
RestartSec=30
TimeoutStopSec=240
UMask=0077

[Install]
WantedBy=multi-user.target
